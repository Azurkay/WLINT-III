  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Vous avez r\xE9ussi \xE0 atteindre le bunker \xE0 temps.\n\nGr\xE2ce \xE0
    vous la camaro SS\na pu f\xEAter No\xEBl en compagnie de Ziak.\n\nLa 7e compagnie
    n'a malheureusement pas pu \xEAtre sauv\xE9e, la faute est \xE0 la malchance,
    qui aurrait pu savoir qu'un bouton rouge d\xE9clencherait une bombe nucl\xE9aire
    ?\n\nLa ville n'as pas non plus eu le temps d'\xEAtre \xE9vacu\xE9e.\n\nLa GameBoy
    a r\xE9sist\xE9 \xE0 l'apocalypse, elle deviendra un sujet d'\xE9tude en 2100.\n\nPlus
    personne n'entendra parler de MS ni de Lucky.\n\nAlpha One est arriv\xE9 apr\xE8s
    les 50h, il ne fait donc pas partie de ce monde. \n\nLe conducteur de la camaro
    restera anonyme.\n\nBabyGang a d\xFB annuler son billet d'avion.\n\nLacrim venait
    tout juste de sortir de prison mais un sgeg a appuy\xE9 sur un bouton rouge.\n\nCelles
    et ceux qui perdent face \xE0 Tezca, vous \xEAtes juste nuls.\n\nJul a eu un
    accident de soucoupe et n'avait pas assez de moulaga pour \xE9galement faire
    partie des 50h.\n\n\n\nOn ne saura toujours pas qui est Silvain."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c80a07325d8b6a245a22820acd7d569b, type: 2}
